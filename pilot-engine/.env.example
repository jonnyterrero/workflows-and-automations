# Firebase — service account JSON for Admin SDK (GitHub Secret in CI,
# local file path via GOOGLE_APPLICATION_CREDENTIALS in dev)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=    # local path to service-account.json

# Public (already connected via MCP for Claude/Perplexity;
# token only needed for standalone scripts/Actions)
PUBLIC_API_TOKEN=

# OKX — create at okx.com → API. Trade-scoped ONLY.
# Withdrawals DISABLED. IP whitelist if supported. Demo profile first.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional data upgrades
QUIVER_API_KEY=                    # paid tier optional; scrapers are free
APIFY_TOKEN=                       # fallback managed scraper
